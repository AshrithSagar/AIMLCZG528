Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: OccupancyGrid
      Topic:
        Value: /map
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: PlannerMarkers
      Topic:
        Value: /planner_markers
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: FinalPath
      Topic:
        Value: /path
      Color: 0; 255; 0
      Line Width: 0.05
      Enabled: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 5
        Y: 5
        Z: 0
Window Geometry:
  Height: 900
  Width: 1400
