Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/PointCloud2
      Name: Map (dense, coloured)
      Enabled: true
      Topic:
        Value: /vslam/map/dense
        Durability Policy: Transient Local
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
    - Class: rviz_default_plugins/PointCloud2
      Name: Map (sparse landmarks)
      Enabled: false
      Topic:
        Value: /vslam/map/points
        Durability Policy: Transient Local
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Path
      Name: Ground truth
      Enabled: true
      Topic:
        Value: /ground_truth/path
        Durability Policy: Transient Local
      Color: 0; 220; 0
      Line Style: Billboards
      Line Width: 0.02
    - Class: rviz_default_plugins/Path
      Name: VSLAM live (drifts)
      Enabled: true
      Topic:
        Value: /vslam/path
      Color: 255; 60; 60
      Line Style: Billboards
      Line Width: 0.02
    - Class: rviz_default_plugins/Path
      Name: VSLAM optimised (after loop closure)
      Enabled: true
      Topic:
        Value: /vslam/optimized_path
        Durability Policy: Transient Local
      Color: 60; 140; 255
      Line Style: Billboards
      Line Width: 0.02
    - Class: rviz_default_plugins/Path
      Name: DL SLAM (dl_trajectory:=..., aligned)
      Enabled: true
      Topic:
        Value: /dl_slam/path
        Durability Policy: Transient Local
      Color: 255; 160; 0
      Line Style: Billboards
      Line Width: 0.02
    - Class: rviz_default_plugins/PoseArray
      Name: Keyframes
      Enabled: true
      Topic:
        Value: /vslam/keyframes
      Shape: Axes
      Axes Length: 0.1
      Axes Radius: 0.01
    - Class: rviz_default_plugins/MarkerArray
      Name: Loop closures
      Enabled: true
      Topic:
        Value: /vslam/loop_closures
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Features (debug)
      Enabled: true
      Topic:
        Value: /vslam/debug/features
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Learned depth (colour | predicted | sensor)
      Enabled: true
      Topic:
        Value: /depth_estimator/debug
        Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 40; 40; 40
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 9
      Pitch: 0.9
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 1
