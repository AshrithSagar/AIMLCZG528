Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Name: Likelihood field (static)
      Enabled: false
      Topic:
        Value: /likelihood_field
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: Sensor-model likelihood (local)
      Enabled: true
      Topic:
        Value: /sensor_model/likelihood
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.6
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: Scan (sensor)
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 50; 50
    - Class: rviz_default_plugins/LaserScan
      Name: Scan (beam-model sample)
      Enabled: false
      Topic:
        Value: /sensor_model/sampled_scan
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 200; 0
    - Class: rviz_default_plugins/LaserScan
      Name: Scan (expected z*)
      Enabled: false
      Topic:
        Value: /sensor_model/expected_scan
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 0; 255; 255
    - Class: rviz_default_plugins/Path
      Name: Ground truth path
      Enabled: true
      Topic:
        Value: /ground_truth/path
      Color: 0; 220; 0
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Wheel-odometry path
      Enabled: true
      Topic:
        Value: /odom_path
      Color: 255; 60; 60
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Motion-model mean path
      Enabled: true
      Topic:
        Value: /motion_model/mean_path
      Color: 80; 160; 255
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/PoseArray
      Name: Motion-model particles
      Enabled: true
      Topic:
        Value: /motion_model/particles
      Shape: Arrow (Flat)
      Color: 120; 180; 255
      Arrow Length: 0.08
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 110
      X: 0
      Y: 0
