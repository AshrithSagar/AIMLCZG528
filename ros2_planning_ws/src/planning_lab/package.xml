<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planning_lab</name>
  <version>0.1.0</version>
  <description>Webinar 4 (AIMLCZG528): path planning part 2 in ROS 2 — A*, D* Lite and a genetic-algorithm
    waypoint planner replanning around moving people, with a pure-pursuit follower and a live evaluator.
    Overlay on ros2_sensor_motion_ws (and optionally ros2_localization_ws).</description>
  <maintainer email="ashrithy@wilp.bits-pilani.ac.in">Ashrith Sagar</maintainer>
  <license>MIT</license>

  <!-- underlay: the W1 workspace (simulator, robot, map) -->
  <exec_depend>sensor_motion_lab</exec_depend>
  <exec_depend>mobile_bot_description</exec_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
